# RentHub Root Environment Variables Template

# PostgreSQL database connection URL (Prisma looks for this or prisma.config.ts loads it)
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/rentalsystem?schema=public"

# JSON Web Token (JWT) secret key (should be a secure, random string in production)
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# Super Admin account seed credentials
SEED_ADMIN_NAME="Yosef Melalaku"
SEED_ADMIN_PHONE="+251905728376"
SEED_ADMIN_PASSWORD="secure_super_admin_password_here"
