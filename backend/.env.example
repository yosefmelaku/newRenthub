# RentHub Backend Environment Variables Template

# Application Port
PORT=5000

# PostgreSQL individual connection options
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="rentalsystem"

# Unified database connection URL for Prisma
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# JSON Web Token (JWT) secret key (should be a secure, random string in production)
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# Super Admin account seed credentials (run bun prisma/seed.ts)
SEED_ADMIN_NAME="Yosef Melalaku"
SEED_ADMIN_PHONE="+251905728376"
SEED_ADMIN_PASSWORD="secure_super_admin_password_here"

# Production-only Security Configuration
# CORS Origin configuration (comma-separated origins or '*' to allow all for open endpoints)
ALLOWED_ORIGINS="http://localhost:5173,https://your-production-app.company.org"

# Express reverse proxy trust setting (e.g. true, 'loopback', 1, 2)
# Set to '1' or 'true' if running behind a single load balancer / reverse proxy (Nginx, AWS, Cloudflare, etc.)
TRUST_PROXY="true"

# Stripe Merchant Configuration (set to sk_test_mock_... for local sandbox simulator)
STRIPE_SECRET_KEY="sk_test_mock_secret_key_renthub_12345"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret_key_12345"
FRONTEND_URL="http://localhost:5173"

# Cloudinary Configuration (for property image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"
