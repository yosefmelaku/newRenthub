# RentHub Backend Environment Variables Template

# PostgreSQL individual connection options
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="rentalsystem"

# Unified database connection URL for Prisma
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# JSON Web Token (JWT) secret key (should be a secure, random string in production)
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# Super Admin account seed credentials (run bun prisma/seed.ts)
SEED_ADMIN_NAME="Yosef Melalaku"
SEED_ADMIN_PHONE="+251905728376"
SEED_ADMIN_PASSWORD="secure_super_admin_password_here"
